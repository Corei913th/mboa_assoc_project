# Configuration MySQL
DB_NAME=mboa_assoc_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Django
SECRET_KEY=votre_secret_key_django_unique
DEBUG=True

# Twilio Configuration (pour l'envoi de SMS OTP)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+237XXXXXXXXX

# OTP Settings
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=3
PHONE_BLOCK_DURATION_HOURS=1
PHONE_MAX_FAILURES=5
